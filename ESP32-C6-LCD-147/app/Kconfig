mainmenu "Waveshare ESP32-C6-LCD-1.47 Application"

menu "Application Wi-Fi Configuration"

config APP_WIFI_SSID
	string "Wi-Fi SSID"
	help
	  SSID of the Wi-Fi network to connect to.

config APP_WIFI_PSK
	string "Wi-Fi Password (PSK)"
	help
	  WPA2/WPA3 pre-shared key (password) of the Wi-Fi network.

config APP_WIFI_CHANNEL
	int "Target Wi-Fi Channel (0 for Auto/Scan)"
	default 0
	range 0 14
	help
	  Target 2.4 GHz Wi-Fi channel (1-14) to connect immediately without
	  scanning all channels. Set to 0 to scan all channels.

config APP_STATIC_IP
	string "Static IPv4 Address (Optional)"
	default ""
	help
	  Optional static IPv4 address (e.g. "192.168.1.250").
	  If empty, DHCPv4 is used automatically.

config APP_STATIC_NETMASK
	string "Static IPv4 Netmask"
	default "255.255.255.0"
	help
	  Subnet mask for static IPv4 configuration.

config APP_STATIC_GW
	string "Static IPv4 Gateway"
	default ""
	help
	  Default gateway IPv4 address (e.g. "192.168.1.1").

endmenu

menu "Sensor and Sampling Configuration"

config APP_SAMPLE_RATE_HZ
	int "Sensor Sampling Rate (Hz)"
	default 10
	range 1 10
	help
	  Target sampling and update frequency for sensor acquisition,
	  SD card logging, and SSE streaming (1 to 10 Hz).

config APP_MOTOR_PULSES_PER_REV
	int "Motor FG Pulses Per Revolution"
	default 6
	help
	  Number of FG pulses generated per complete motor shaft revolution.

config APP_MAX_FG_RPM
	int "Max Motor FG RPM (100% Gauge Scale)"
	default 5500
	help
	  Maximum RPM representing 100% on the LCD display bar and web chart.

endmenu

source "Kconfig.zephyr"
