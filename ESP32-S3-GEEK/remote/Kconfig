menu "Real-Time Sensor and Motor Sampling Configuration"

config APP_SAMPLE_RATE_HZ
	int "Sensor Sampling Rate (Hz)"
	default 10
	range 1 10
	help
	  Target sampling and update frequency for motor FG acquisition,
	  INA219 power sampling, and inter-core telemetry (1 to 10 Hz).

config APP_MOTOR_PULSES_PER_REV
	int "Motor FG Pulses Per Revolution"
	default 6
	help
	  Number of FG pulses generated per complete motor shaft revolution.

config APP_MAX_FG_RPM
	int "Maximum Motor FG RPM"
	default 5500
	help
	  100% scale for Motor FG RPM gauge.

config APP_MAX_POWER_W
	int "Maximum Motor Power (Watts)"
	default 25
	help
	  100% scale for Power gauge in Watts.

config APP_MOTOR_KICK_RESET_MS
	int "Pre-kick 0% PWM reset delay (ms)"
	default 200
	range 0 10000
	help
	  Duration in milliseconds to hold 0% PWM before applying a spin-up or
	  stall-recovery kick, allowing the motor ESC to clear any locked-rotor
	  stall protection latch. Set to 0 to disable the 0% reset delay.

config APP_MOTOR_KICK_PWM_PCT
	int "Spin-up / stall recovery kick PWM (%)"
	default 20
	range 0 100
	help
	  Minimum PWM duty cycle percentage applied during spin-up and
	  stall-recovery kicks until the motor spins.

endmenu

source "Kconfig.zephyr"
