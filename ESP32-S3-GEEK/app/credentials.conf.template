# Template for local Wi-Fi credentials
# Copy this file to 'credentials.conf' and fill in your network credentials:
#   cp credentials.conf.template credentials.conf
#
# 'credentials.conf' is ignored by Git and automatically merged during build.

CONFIG_APP_WIFI_SSID="YOUR_WIFI_SSID"
CONFIG_APP_WIFI_PSK="YOUR_WIFI_PASSWORD"

# Optional Static IPv4 (leave unset or empty "" to use DHCP):
